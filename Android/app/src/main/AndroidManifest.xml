<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- テレビ (同じ LAN) に問い合わせる -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 から、同じ LAN の機器 (テレビ・Mirakurun) への通信には、ユーザーの許可が要る -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- ロック画面と通知に、映っている番組とリモコンのボタンを出す (Android 13 から許可が要る) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 から、その通知をステータスバーのチップとロック画面の上に出す (Live Updates) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- ライブ視聴の配信 (EPGStation) は家の LAN の中の http なので、暗号化していない通信を許す -->
    <application
        android:name=".RegzaApplication"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.RegzaRemote">
        <!-- ウィジェット (:platform:widgets) と Live Updates の受け口 (:platform:liveupdate) は、それぞれのモジュールの AndroidManifest.xml で登録する -->
        <!-- 回転しても作り直さない (ライブ視聴の再生を途切れさせない) -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
